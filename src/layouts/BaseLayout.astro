---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arnav Sharma — AI/ML & Full-Stack Engineer",
  description = "Portfolio of Arnav Sharma, an AI/ML & Full-Stack Engineering student building intelligent software and full-stack web apps.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/sprites/kodama-sheet.png" />
    <title>{title}</title>
    <link rel="preload" as="font" type="font/woff2" href="https://cdn.jsdelivr.net/gh/IdreesInc/Monocraft@main/dist/Monocraft-woff2/Monocraft.woff2" crossorigin />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="pb-24 md:pb-16">
    <slot />
  </body>
</html>
