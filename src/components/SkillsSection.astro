---
import { SKILL_GROUPS } from "../data/portfolio";
---

<section id="skills-section" class="max-w-[840px] mx-auto px-4 sm:px-6">
  <h2 class="font-mono text-xl font-bold text-[#C0CAF5] tracking-tight mt-16 mb-6">
    // TECH_STACK
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    {SKILL_GROUPS.map((group) => (
      <article
        id={group.id}
        class="neo-card relative mt-16 p-6 bg-[#1A1B26] border-[1.5px] border-[#414868]"
        data-kodama-trigger
        data-kodama-id={group.id}
        data-kodama-message={group.kodamaMessage}
      >
        <div
          data-kodama-perch
          class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
          aria-hidden="true"
        ></div>

        <div class="flex flex-wrap items-center gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
          <span class="inline-block w-2 h-2 bg-[#7DCFFF]"></span>
          <span class="text-xs opacity-75 break-all min-w-0">{group.path}</span>
        </div>

        <h3 class="font-mono text-sm font-bold text-[#C0CAF5] tracking-tight mb-3">
          {group.title}
        </h3>

        <ul class="space-y-1.5">
          {group.skills.map((skill) => (
            <li class="flex items-start gap-2 font-sans text-xs text-[#A9B1D6]">
              <span class="font-mono text-[#FF9E64] shrink-0">-&gt;</span>
              <span>{skill}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
