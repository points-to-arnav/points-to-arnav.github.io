---
import { INTERESTS_DATA } from "../data/portfolio";
---

<section id="interests-section" class="max-w-[840px] mx-auto px-4 sm:px-6">
  <h2 class="font-mono text-xl font-bold text-[#C0CAF5] tracking-tight mt-16 mb-6">
    // BEYOND_CODE
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {INTERESTS_DATA.map((interest) => (
      <article
        id={interest.id}
        class="neo-card relative mt-16 p-6 bg-[#1A1B26] border-[1.5px] border-[#414868]"
        data-kodama-trigger
        data-kodama-id={interest.id}
        data-kodama-message={interest.kodamaMessage}
      >
        <div
          data-kodama-perch
          class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
          aria-hidden="true"
        ></div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
          <span class="opacity-75 break-all min-w-0">{interest.path}</span>
          <span class="text-[#9ECE6A]">{interest.badge}</span>
        </div>

        <h3 class="font-mono text-sm font-bold text-[#C0CAF5] tracking-tight mb-2">
          {interest.title}
        </h3>
        <p class="font-sans text-xs text-[#A9B1D6] leading-relaxed">
          {interest.description}
        </p>
      </article>
    ))}
  </div>
</section>
