---
import { CONTACT_DATA } from "../data/portfolio";
---

<section class="max-w-[840px] mx-auto px-4 sm:px-6">
  <article
    id={CONTACT_DATA.id}
    class="neo-card relative mt-16 p-6 bg-[#1A1B26] border-[1.5px] border-[#414868]"
    data-kodama-trigger
    data-kodama-id={CONTACT_DATA.id}
    data-kodama-message={CONTACT_DATA.kodamaMessage}
  >
    <div
      data-kodama-perch
      class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-[#FF9E64]"></span>
        <span>{CONTACT_DATA.path}</span>
      </div>
      <span class="text-[#9ECE6A]">[CONTACT]</span>
    </div>

    <h2 class="font-mono text-xl font-bold text-[#C0CAF5] tracking-tight mb-3">
      {CONTACT_DATA.heading}
    </h2>
    <p class="font-sans text-sm text-[#A9B1D6] leading-relaxed mb-5">
      {CONTACT_DATA.subtext}
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <button
        id="copy-email-btn"
        type="button"
        data-email={CONTACT_DATA.email}
        class="neo-btn font-mono text-xs px-3 py-1.5 bg-[#13141C] border border-[#7DCFFF] text-[#7DCFFF] hover:bg-[#7DCFFF] hover:text-[#16161E]"
      >
        <span id="copy-email-label">[ CP EMAIL ]</span>
      </button>

      <a
        href={CONTACT_DATA.github}
        target="_blank"
        rel="noopener noreferrer"
        class="neo-btn font-mono text-xs px-3 py-1.5 bg-[#13141C] border border-[#414868] text-[#C0CAF5] hover:border-[#7DCFFF] hover:text-[#7DCFFF]"
      >
        [ GitHub ↗ ]
      </a>
    </div>
  </article>
</section>

<script>
  const copyBtn = document.getElementById("copy-email-btn") as HTMLButtonElement | null;
  const copyLabel = document.getElementById("copy-email-label");

  if (copyBtn && copyLabel) {
    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    copyBtn.addEventListener("click", async () => {
      const email = copyBtn.dataset.email ?? "";

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = email;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
      }

      copyLabel.textContent = "[ OK COPIED! ]";

      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyLabel.textContent = "[ CP EMAIL ]";
      }, 1600);
    });
  }
</script>
