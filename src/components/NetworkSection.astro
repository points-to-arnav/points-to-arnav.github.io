---
import { NETWORK_DATA } from "../data/portfolio";
---

<section id="network-section" class="max-w-[840px] mx-auto px-4 sm:px-6">
  <div id="network" class="flex flex-wrap items-center gap-2 mt-16 font-mono text-xs text-[#787C99]">
    <span class="inline-block w-2 h-2 bg-[#FF9E64]"></span>
    <span>~/arnav/cool_people.json</span>
  </div>
  <h2 class="text-xl font-bold text-[#C0CAF5] tracking-tight mt-2 mb-6">
    // COOL_PEOPLE_I_KNOW
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {NETWORK_DATA.map((person) => (
      <article
        id={person.id}
        class="neo-card relative mt-16 p-6 bg-[#1A1B26]"
        data-kodama-trigger
        data-kodama-id={person.id}
        data-kodama-message={person.kodamaMessage}
      >
        <div
          data-kodama-perch
          class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
          aria-hidden="true"
        ></div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
          <span class="opacity-75 break-all min-w-0">{person.path}</span>
          <span class="text-[#9ECE6A]">{person.role}</span>
        </div>

        <h3 class="text-sm font-bold text-[#C0CAF5] tracking-tight mb-2">{person.name}</h3>
        <p class="font-sans text-xs text-[#A9B1D6] leading-relaxed">{person.description}</p>

        <a
          href={person.url}
          target="_blank"
          rel="noopener noreferrer"
          class="neo-btn inline-block mt-4 font-mono text-xs px-3 py-1.5 bg-[#13141C] text-[#C0CAF5] hover:text-[#7DCFFF]"
        >
          {person.linkLabel}
        </a>
      </article>
    ))}
  </div>
</section>
