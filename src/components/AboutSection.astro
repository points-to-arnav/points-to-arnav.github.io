---
import { PERSONAL_DETAILS, ABOUT_ME_DATA } from "../data/portfolio";
---

<section class="max-w-[840px] mx-auto px-4 sm:px-6">
  <!-- HERO / PERSONAL DETAILS CARD -->
  <article
    id={PERSONAL_DETAILS.id}
    class="neo-card relative mt-16 p-6 bg-[#1A1B26] border-[1.5px] border-[#414868]"
    data-kodama-trigger
    data-kodama-id={PERSONAL_DETAILS.id}
    data-kodama-message={PERSONAL_DETAILS.kodamaMessage}
  >
    <div
      data-kodama-perch
      class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-[#9ECE6A]"></span>
        <span>~/arnav/whoami.sh</span>
      </div>
      <span class="text-[#9ECE6A]">{PERSONAL_DETAILS.status}</span>
    </div>

    <h1 class="font-mono text-2xl sm:text-3xl font-bold text-[#C0CAF5] tracking-tight mb-1">
      {PERSONAL_DETAILS.name}
    </h1>
    <p class="font-heading text-sm text-[#FF9E64] mb-4">{PERSONAL_DETAILS.role}</p>
    <p class="font-sans text-sm text-[#A9B1D6] leading-relaxed mb-4">
      {PERSONAL_DETAILS.tagline}
    </p>

    <div class="flex flex-wrap gap-2 mb-5 font-mono text-[11px] text-[#7DCFFF]">
      <span class="px-2 py-0.5 bg-[#13141C] border border-[#414868]">[{PERSONAL_DETAILS.location}]</span>
      <span class="px-2 py-0.5 bg-[#13141C] border border-[#414868]">[{PERSONAL_DETAILS.focus}]</span>
    </div>

    <div class="flex items-center gap-3 pt-3 border-t border-[#292E42]">
      <a
        href={PERSONAL_DETAILS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="neo-btn font-mono text-xs px-3 py-1.5 bg-[#13141C] border border-[#414868] text-[#C0CAF5] hover:border-[#7DCFFF] hover:text-[#7DCFFF]"
      >
        [ GitHub ↗ ]
      </a>
      <a
        href={`mailto:${PERSONAL_DETAILS.email}`}
        class="neo-btn font-mono text-xs px-3 py-1.5 bg-[#13141C] border border-[#7DCFFF] text-[#7DCFFF] hover:bg-[#7DCFFF] hover:text-[#16161E]"
      >
        [ Email ↗ ]
      </a>
    </div>
  </article>

  <!-- ABOUT ME CARD -->
  <article
    id={ABOUT_ME_DATA.id}
    class="neo-card relative mt-16 p-6 bg-[#1A1B26] border-[1.5px] border-[#414868]"
    data-kodama-trigger
    data-kodama-id={ABOUT_ME_DATA.id}
    data-kodama-message={ABOUT_ME_DATA.kodamaMessage}
  >
    <div
      data-kodama-perch
      class="hidden md:block absolute -top-[48px] right-5 w-[48px] h-[48px] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#414868] pb-3 mb-4 font-mono text-xs text-[#787C99]">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-[#7DCFFF]"></span>
        <span class="opacity-75 break-all min-w-0">{ABOUT_ME_DATA.path}</span>
      </div>
      <span class="text-[#9ECE6A]">[ABOUT_ME]</span>
    </div>

    <h2 class="font-mono text-xl font-bold text-[#C0CAF5] tracking-tight mb-4">
      // ABOUT_ME
    </h2>

    {ABOUT_ME_DATA.paragraphs.map((paragraph) => (
      <p class="font-sans text-sm text-[#A9B1D6] leading-relaxed mb-4">{paragraph}</p>
    ))}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 pt-4 border-t border-[#292E42]">
      {ABOUT_ME_DATA.quickFacts.map((fact) => (
        <div class="bg-[#13141C] border border-[#414868] px-3 py-2">
          <p class="font-mono text-[10px] text-[#787C99] mb-1">{fact.label}</p>
          <p class="font-sans text-xs text-[#C0CAF5]">{fact.value}</p>
        </div>
      ))}
    </div>
  </article>
</section>
